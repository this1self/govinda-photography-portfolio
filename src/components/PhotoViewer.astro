<dialog class="viewer" id="photo-viewer" aria-labelledby="viewer-title">
    <div class="viewer-layout">
        <header class="viewer-header">
            <div class="viewer-heading">
                <h2 id="viewer-title"></h2>
                <span class="viewer-counter" id="viewer-counter" aria-live="polite" aria-atomic="true"></span>
            </div>
            <button class="icon-button" id="viewer-close" type="button" aria-label="Close viewer" autofocus>
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16" /></svg>
            </button>
        </header>
        <div class="viewer-stage" id="viewer-stage">
            <div class="viewer-images" id="viewer-images"></div>
            <div class="viewer-status" id="viewer-status" role="status" hidden>
                <span class="loading-ring" aria-hidden="true"></span>
                <span id="viewer-status-text">Loading photograph</span>
                <button type="button" id="viewer-retry" hidden>Try again</button>
            </div>
        </div>
        <footer class="viewer-footer">
            <button class="icon-button viewer-previous" id="viewer-previous" type="button" aria-label="Previous photograph">
                <svg width="12" height="22" viewBox="0 0 12 22" fill="none" stroke="currentColor" aria-hidden="true"><path d="M11 1L1 11l10 10" /></svg>
            </button>
            <span aria-hidden="true"></span>
            <button class="icon-button viewer-next" id="viewer-next" type="button" aria-label="Next photograph">
                <svg width="12" height="22" viewBox="0 0 12 22" fill="none" stroke="currentColor" aria-hidden="true"><path d="M1 1l10 10L1 21" /></svg>
            </button>
        </footer>
    </div>
</dialog>
