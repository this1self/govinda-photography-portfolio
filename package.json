{
    "name": "govinda-photography-portfolio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "node scripts/prepare-media.mjs --preview && astro dev --host 127.0.0.1",
        "media": "node scripts/prepare-media.mjs",
        "check": "astro check",
        "test": "npm run build && node --test tests/*.test.mjs",
        "build": "node scripts/prepare-media.mjs && astro check && astro build && node scripts/audit-build.mjs dist",
        "build:preview": "node scripts/prepare-media.mjs --preview && astro check && PORTFOLIO_PREVIEW=1 astro build && node scripts/audit-build.mjs dist-preview --preview",
        "preview": "astro preview --host 127.0.0.1",
        "deploy": "npm run build && wrangler deploy",
        "test:ui": "npm run build && playwright test",
        "test:ui:list": "playwright test --list"
    },
    "dependencies": {
        "astro": "7.3.5",
        "sharp": "0.35.5"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "typescript": "6.0.3",
        "wrangler": "4.152.0",
        "@playwright/test": "1.65.0",
        "happy-dom": "21.0.4"
    }
}
