{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "govinda-photography-portfolio",
    "compatibility_date": "2026-11-10",
    "workers_dev": false,
    "preview_urls": false,
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
    },
    "routes": [
        {
            "pattern": "photography.govindarampingali.com",
            "custom_domain": true
        }
    ]
}
